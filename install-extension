#!/usr/bin/env bash
set -eo pipefail

NAME=$1
BRANCH=${BRANCH:-REL1_46}
REPO=${REPO:-https://gerrit.wikimedia.org/r/mediawiki/extensions/$NAME}

cd /var/www/html/extensions
git clone "$REPO" --branch "$BRANCH" --depth 1 "$NAME"
cd "$NAME"

if [[ -n "${NO_COMPOSER}" ]]; then
    composer install --no-dev
fi
