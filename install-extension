#!/usr/bin/env bash
set -eo pipefail

NAME=$1
BRANCH=${BRANCH:-REL1_46}
EXTENSION_TYPE=${EXTENSION_TYPE:-extension}
REPO=${REPO:-https://gerrit.wikimedia.org/r/mediawiki/${EXTENSION_TYPE}s/$NAME}

cd "/var/www/html/w/${EXTENSION_TYPE}s"
git clone "$REPO" --branch "$BRANCH" --depth 1 "$NAME"
cd "$NAME"

if [[ ! -n "${NO_COMPOSER}" ]]; then
    composer install --no-dev
fi
